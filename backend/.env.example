# Copy to .env and change the values. Never commit .env.
# Docker database (docker compose up db) listens on 5433 on your PC.
DATABASE_URL=postgresql://coldchain:coldchain@localhost:5433/coldchain
DEVICE_API_KEY=change-me

TEMP_MIN_C=2.0
TEMP_MAX_C=8.0

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=coldchain/+/telemetry
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_CA_CERT=
